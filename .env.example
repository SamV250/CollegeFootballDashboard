# Copy to `.env` and fill in what you have. Everything is optional — with no
# variables set, the dashboard runs entirely on the synthetic demo dataset.

# --- Data sources -----------------------------------------------------------
# CollegeFootballData API key (https://collegefootballdata.com/key). When set,
# the pipeline prefers CFBD over ESPN / demo.
CFBD_API_KEY=

# Force a single data source regardless of config priority.
# One of: cfbd | espn | local | demo
# DATA_SOURCE=demo

# --- Season override ------------------------------------------------------
# Leave unset to auto-detect the active season from the system date.
# FORCE_SEASON=2026

# --- Runtime -----------------------------------------------------------
# Streamlit server port (used by scripts/run_app.sh)
STREAMLIT_SERVER_PORT=8501

# Optional: default display time zone for timestamps
# APP_TIMEZONE=US/Eastern
